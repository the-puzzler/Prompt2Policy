<mujoco model="fr3 reach">
  <include file="../mujoco_menagerie/franka_fr3/fr3.xml"/>

  <statistic center="0.2 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="target_green" rgba="0.2 0.8 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Target (green sphere) -->
    <body name="target" pos="0.4 0.0 0.4">
      <geom name="target_geom" type="sphere" size="0.025" material="target_green"
            contype="0" conaffinity="0"/>
      <site name="target_site" size="0.001"/>
    </body>

    <!-- Side camera (for viewer) -->
    <camera name="front_camera" pos="1.5 -1.0 1.3" xyaxes="0.6247 0.7809 0 -0.4011 0.3209 0.858" fovy="50"/>

    <!-- Top-down camera for observation (centered over workspace) -->
    <camera name="top_camera" pos="0.35 0.0 1.4" xyaxes="0 -1 0 1 0 0" fovy="60"/>
  </worldbody>
</mujoco>
